# Public values from your own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
# Fast extraction and the stronger authoritative review remain separate calls
# with separate prompts and validation responsibilities.
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_QUALITY_MODEL=google/gemini-2.5-flash
OPENROUTER_REVIEW_MODEL=~google/gemini-pro-latest
# Bound hidden reasoning separately so it cannot consume the whole completion
# budget before the reviewer returns its required compact JSON decision.
OPENROUTER_REVIEW_REASONING_TOKENS=2048
OPENROUTER_REVIEW_MAX_OUTPUT_TOKENS=16384
OPENROUTER_REVIEW_TIMEOUT_MS=360000
# Normal worker review is staged: own-source audits, whole-packet reconciliation,
# then candidate decisions in bounded batches. These are workload budgets, not
# document-format matching rules. All stages use OPENROUTER_REVIEW_MODEL.
PACKET_SOURCE_REVIEW_CONCURRENCY=3
PACKET_SOURCE_REVIEW_MAX_OUTPUT_TOKENS=8192
PACKET_RECONCILIATION_MAX_OUTPUT_TOKENS=8192
PACKET_REVIEW_DECISION_BATCH_SIZE=12
PACKET_DECISION_REVIEW_MAX_OUTPUT_TOKENS=6144
# Source pages are reduced only for the final review call. First-pass extraction
# still receives the higher-resolution render.
PACKET_REVIEW_IMAGE_MAX_DIMENSION=1800
PACKET_REVIEW_IMAGE_JPEG_QUALITY=82
# Provider-enforced review JSON avoids missing-property format retries.
# Application validation and the complete source audit still run afterward.
PACKET_STRICT_REVIEW_SCHEMA=true
# Legacy whole-packet helper only. The normal worker always verifies every
# source and reconciles the packet through the staged review contract.
PACKET_INDEPENDENT_REVIEW_ENABLED=false
PACKET_AI_CONCURRENCY=6
# Comma-separated legal/trading names for this installation. This is used only
# to distinguish the workspace owner from external counterparties in case names.
INTERNAL_COMPANY_NAMES=
# Page-boundary classification needs much less reasoning than field extraction.
PACKET_SPLIT_REASONING_TOKENS=256
PACKET_SPLIT_MAX_OUTPUT_TOKENS=1600
WORKER_SECRET=

# Local: use Netlify Dev for background processing.
# Production: your Samrat Netlify HTTPS URL.
APP_BASE_URL=http://localhost:8888

# SAP SPAPI (server only). Test is the default; set SAP_API_ENV=live for production.
# OpenPO/OpenGRPO are GET-only reads. Creation needs POST URLs from the SAP team.
SAP_API_ENV=test
SAP_TEST_BASE_URL=https://sbivan.samratgroup.com:9010
SAP_TEST_USERNAME=Development
SAP_TEST_PASSWORD=
SAP_LIVE_BASE_URL=https://sbivan.samratgroup.com:9011
SAP_LIVE_USERNAME=Production
SAP_LIVE_PASSWORD=
# Leave empty until the SAP team shares POST create endpoints for GRPO (GRN)
# and AP Invoice. While empty, the SAP button prepares + saves payloads and
# reports SAP_CREATE_API_MISSING instead of posting.
SAP_CREATE_GRPO_URL=
SAP_CREATE_AP_URL=

# Optional fixed-egress proxy for all server-side SAP requests. Keep this
# server-only and configure it as a secret in the deployment environment.
QUOTAGUARDSTATIC_URL=

# Document processing limits.
PACKET_MAX_PAGES=40
PACKET_PDF_RENDER_MAX_PAGES=40
PACKET_PDF_SMART_SPLIT_MAX_PAGES=40
